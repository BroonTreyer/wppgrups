PORT=3000
# Interface onde o painel escuta. 127.0.0.1 = so o proprio servidor; o acesso
# remoto e por tunel SSH. So use 0.0.0.0 se souber exatamente por que — o painel
# publica nos seus grupos e canais.
HOST=127.0.0.1
APP_BASE_URL=http://localhost:3000
ADMIN_TOKEN=troque-por-uma-chave-longa
ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_WEBHOOK_SECRET=troque-por-um-segredo-longo
DRY_RUN=true
MAX_POSTS_PER_CHANNEL_PER_DAY=40
MAX_POSTS_PER_GROUP_PER_DAY=12
CHANNEL_MINUTES_BETWEEN_POSTS=20
GROUP_MINUTES_BETWEEN_POSTS=45
# Quantos posts um destino NOVO solta de uma vez quando chega a vez dele.
# 1 = gotejamento (um post por intervalo). Acima de 1, o intervalo passa a valer
# para a rajada inteira: burstSize 15 com intervalo de 10 min = 15 posts seguidos
# a cada 10 min. Quem manda no dia a dia e o burstSize gravado em cada destino,
# ajustavel por destino; isto aqui e so o padrao de quem acabou de ser criado.
POSTS_PER_BURST=1
DEDUPLICATION_HOURS=24
PUBLISHING_START_HOUR=8
PUBLISHING_END_HOUR=23
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
QUEUE_RETRY_DELAY_MINUTES=5
# Ative somente depois de homologar send-image com um ID @newsletter.
ZAPI_CHANNEL_IMAGE_ENABLED=false

# Ingestao automatica de ofertas
# Cole apenas a query string que aparece nos links gerados no seu painel de afiliados do Mercado Livre.
# Exemplo: matt_word=SEU_ID&matt_tool=88344921
MELI_AFFILIATE_PARAMS=
# Publicar sem tag de afiliado (perde comissao). Mantenha false.
ALLOW_UNTAGGED_LINKS=false
INGESTION_ENABLED=true
INGESTION_INTERVAL_MINUTES=30
INGESTION_MEMORY_HOURS=72
INGESTION_PRICE_DROP_TOLERANCE=0.05

# Anti-repeticao e frescor de preco
REPUBLISH_COOLDOWN_DAYS=30
PRICE_FRESHNESS_MINUTES=25
QUEUE_MAX_AGE_HOURS=6
PRICE_RISE_TOLERANCE=0.02
MIN_DISCOUNT_AFTER_REFRESH=10
REFRESH_PAGES=2

# Retencao do historico
RETENTION_PUBLICATION_DAYS=90
RETENTION_QUEUE_DAYS=7
RETENTION_MAX_OFFERS=5000

# Validade da promocao e tamanho da fila
MIN_OFFER_VALIDITY_MINUTES=30
URGENT_OFFER_MINUTES=120
QUEUE_HORIZON_HOURS=2
MIN_MINUTES_BETWEEN_POSTS_FLOOR=3

# Link de afiliado
# false = so publica com link oficial gerado pela extensao ou pelo linkbuilder
ALLOW_PARAM_LINKS=false
AFFILIATE_EXTENSION_TIMEOUT_MINUTES=10

# Classificacao por IA (Claude). Desligada por padrao: sem chave, a regra decide sozinha.
# A chave sai de console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
AI_CLASSIFIER_ENABLED=false
AI_CLASSIFIER_MODEL=claude-opus-5
# low basta para classificar titulo curto; suba so se o julgamento estiver raso.
AI_CLASSIFIER_EFFORT=low
AI_CLASSIFIER_BATCH_SIZE=25
# Cada produto se paga uma vez por mes, nao a cada rodada de ingestao.
AI_CLASSIFIER_MEMORY_DAYS=30
